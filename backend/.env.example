PORT=3001
NODE_ENV=development

# Allowed browser origins (comma-separated)
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Supabase Server Credentials (NEVER expose SERVICE_ROLE_KEY in frontend or admin bundles)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 Web Client ID & Secret (public customer login verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security Keys (generate 32+ random hex/base64 chars before production!)
TOTP_ENCRYPTION_KEY=dev-local-only-32-byte-secret-key!
COOKIE_DOMAIN=
