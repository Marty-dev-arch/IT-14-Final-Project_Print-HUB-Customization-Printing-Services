{
  "name": "rj-hub-printing-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n BACKEND,CUSTOMER,ADMIN -c cyan,green,magenta \"npm run dev:backend\" \"npm run dev:customer\" \"npm run dev:admin\"",
    "dev:customer": "vite --port 5173",
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
